# Copie para .env (ou exporte no shell) e ajuste os valores.
# Nunca commite o .env de verdade.

# Backend / Postgres
DB_URL=jdbc:postgresql://localhost:5432/remediot
DB_USERNAME=postgres
DB_PASSWORD=remediot

# JWT — gere um segredo forte para produção (ex.: openssl rand -base64 48)
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_EXPIRATION_MS=86400000

# CORS (origem do frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Intervalo (ms) do scheduler que marca doses como NAO_RETIRADA
SCHEDULER_INTERVAL_MS=300000

# Chave do dispositivo — gancho futuro para o Node-RED chamar /api/devices/events
DEVICE_API_KEY=dev-only-device-key-change-me

# Dados de exemplo (cuidador + 4 pacientes) na primeira execução com banco vazio
SEED_ENABLED=true

# Gaveta (ESP32) por MQTT no EMQX Cloud — ver docs/gaveta/CONTRATO-MQTT.md.
# Use o usuário do BACKEND (remediot-backend), nunca o dos dispositivos.
# A senha vem por mensagem privada: nunca coloque o valor real neste arquivo.
MQTT_ENABLED=false
MQTT_HOST=xxxxxxxx.ala.us-east-1.emqxsl.com
MQTT_PORTA=8883
MQTT_USUARIO=remediot-backend
MQTT_SENHA=troque-me
# Um clientId diferente por máquina que rodar o backend (o broker derruba ids repetidos)
MQTT_CLIENT_ID=remediot-backend-lucas
