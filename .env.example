# Copie para .env (ou exporte no shell) e ajuste os valores.
# Nunca commite o .env de verdade.

# Backend / Postgres
DB_URL=jdbc:postgresql://localhost:5432/remediot
DB_USERNAME=postgres
DB_PASSWORD=remediot

# JWT — gere um segredo forte para produção (ex.: openssl rand -base64 48)
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_EXPIRATION_MS=86400000

# CORS (origem do frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Intervalo (ms) do scheduler que marca doses como NAO_RETIRADA
SCHEDULER_INTERVAL_MS=300000

# Chave do dispositivo — gancho futuro para o Node-RED chamar /api/devices/events
DEVICE_API_KEY=dev-only-device-key-change-me
